@startuml
title <size:24>System Context View: Personal AI Trainer</size>\n<size:24>The trainer among its actor and the external provider.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>

Person(Athlete, "Athlete", $descr="States a goal, logs completed workouts, reads plans.", $tags="", $link="")
System(LLMProvider, "LLM Provider", $descr="Drafts plan content from a goal and training history.", $tags="", $link="")
System(PersonalAITrainer, "Personal AI Trainer", $descr="Turns a stated goal into a training plan and adapts it to the workouts actually completed.", $tags="", $link="")

Rel(Athlete, PersonalAITrainer, "Submits goals, logs Sessions", $techn="HTTPS, JSON", $tags="", $link="")
Rel(PersonalAITrainer, LLMProvider, "Requests a draft plan", $techn="HTTPS, JSON", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml