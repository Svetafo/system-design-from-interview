<mxfile host="app.diagrams.net" type="device">
  <diagram name="C4 Containers" id="c4-containers">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="user" value="[Actor]&#10;[Person]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="api" value="[API]&#10;[Container: Language, framework]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="240" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="db" value="[Database]&#10;[PostgreSQL]" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="360" width="150" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ext" value="[External system]&#10;[External System]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="120" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="[what the actor does]&#10;[HTTPS/REST]" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="user" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="Reads and writes&#10;[JDBC]" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="api" target="db">
